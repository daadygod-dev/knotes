{
    "name": "knotes",
    "version": "1.1.0",
    "private": true,
    "type": "module",
    "description": "KNOTES - a local-first notes app with fast search and an AI planning assistant, built on SQLite FTS5.",
    "repository": {
        "type": "git",
        "url": "https://github.com/daadygod-dev/knotes.git"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "dev": "node --no-warnings --env-file-if-exists=.env --watch src/server.mjs",
        "start": "node --no-warnings --env-file-if-exists=.env src/server.mjs",
        "icon": "node --no-warnings scripts/generate-app-icon.mjs",
        "icon:prompt": "node --no-warnings scripts/generate-app-icon.mjs --prompt-only",
        "icon:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-windows-icon.ps1 -Source public/app-icon.png",
        "build:win": "node --no-warnings scripts/build-windows.mjs",
        "test": "node --no-warnings --test"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "postject": "^1.0.0-alpha.6"
    }
}
